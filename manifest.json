{
  "manifest_version": 3,
  "name": "久坐提醒",
  "version": "0.1.0",
  "description": "工作计时与健康休息提醒扩展。",
  "icons": {
    "16": "src/assets/icons/time-reminder-16.png",
    "32": "src/assets/icons/time-reminder-32.png",
    "48": "src/assets/icons/time-reminder-48.png",
    "128": "src/assets/icons/time-reminder-128.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "action": {
    "default_title": "久坐提醒",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/icons/time-reminder-16.png",
      "32": "src/assets/icons/time-reminder-32.png",
      "48": "src/assets/icons/time-reminder-48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/notification/notification.html",
        "src/notification/notification.css",
        "src/notification/notification.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
