{
  "manifest_version": 3,
  "name": "久坐提醒",
  "version": "1.4.3",
  "description": "工作计时与健康休息提醒扩展。",
  "icons": {
    "16": "assets/icons/time-reminder-16.png",
    "32": "assets/icons/time-reminder-32.png",
    "48": "assets/icons/time-reminder-48.png",
    "128": "assets/icons/time-reminder-128.png"
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "久坐提醒",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/time-reminder-16.png",
      "32": "assets/icons/time-reminder-32.png",
      "48": "assets/icons/time-reminder-48.png"
    }
  }
}
